# One command: `docker compose up --build`
# App → http://localhost:${WEB_PORT:-3000}, PocketBase → http://localhost:${PB_PORT:-8090}
#
# VITE_POCKETBASE_URL is the address the BROWSER uses to reach PocketBase.
# It is baked into the web bundle at build time, so after changing it you
# must rebuild (`docker compose up --build`). For VPS/single-domain deploys,
# set it to your public URL, e.g. https://example.com
VITE_POCKETBASE_URL=http://localhost:8090

# Host ports (container ports stay 8090/3000). Override e.g.:
#   PB_PORT=8091 WEB_PORT=3002 docker compose up --build
PB_PORT=8090
WEB_PORT=3000
WEB_DEV_PORT=3001
